<?xml version="1.0" encoding="utf-8"?>
<!-- Widget ab etwa 2×2 Zellen: Titel mit Tag, Name, letzter Kontakt,
     Knöpfe „Anrufen“, „WhatsApp“, „Heute nicht“; ab etwa 3×3 dazu die
     nächsten Vorschläge (feste Zeilen, unten abgeschnitten). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_padding"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/widget_padding"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_call"
            android:tint="@color/widget_primary" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/widget_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_call"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_action_background"
            android:contentDescription="@string/widget_call"
            android:padding="11dp"
            android:src="@drawable/ic_widget_call"
            android:tint="@color/widget_on_primary_container" />

        <ImageView
            android:id="@+id/widget_whatsapp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_action_background"
            android:contentDescription="@string/widget_whatsapp"
            android:padding="11dp"
            android:src="@drawable/ic_widget_chat"
            android:tint="@color/widget_on_primary_container" />

        <ImageView
            android:id="@+id/widget_later"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_action_background"
            android:contentDescription="@string/widget_later"
            android:padding="11dp"
            android:src="@drawable/ic_widget_snooze"
            android:tint="@color/widget_on_primary_container" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_upcoming_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
