<?xml version="1.0" encoding="utf-8"?>
<!-- Vorschau in der Widget-Auswahl (Android 12+), Beispielinhalt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_padding"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/widget_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_call"
            android:tint="@color/widget_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_label"
            android:textColor="@color/widget_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_preview_name"
        android:textColor="@color/widget_on_surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_detail"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_action_background"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:src="@drawable/ic_widget_call"
            android:tint="@color/widget_on_primary_container" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_action_background"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:src="@drawable/ic_widget_chat"
            android:tint="@color/widget_on_primary_container" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_action_background"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:src="@drawable/ic_widget_snooze"
            android:tint="@color/widget_on_primary_container" />
    </LinearLayout>
</LinearLayout>
